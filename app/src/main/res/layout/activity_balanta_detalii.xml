<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/margin_standard"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Titlu dinamic -->
        <TextView
            android:id="@+id/textViewTitlu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titlu_dinamic"
            android:textSize="@dimen/text_title_size"
            android:textStyle="bold"
            android:textColor="#041B2E"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_small" />

        <!-- Data curentă (opțional) -->
        <TextView
            android:id="@+id/textViewData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/data_placeholder"
            android:textSize="@dimen/text_body_size"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- Caseta balanței -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="@dimen/margin_standard"
            android:elevation="4dp"
            android:layout_marginBottom="@dimen/margin_xlarge">

            <!-- Cotizații -->
            <TextView
                android:id="@+id/textCotizatie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/total_cotizatie"
                android:textSize="@dimen/text_header_size"
                android:textStyle="bold"
                android:textColor="@color/venit_color"
                android:layout_marginBottom="@dimen/margin_medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="@dimen/margin_medium" />

            <!-- Donații -->
            <TextView
                android:id="@+id/textDonatii"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/total_donatii"
                android:textSize="@dimen/text_header_size"
                android:textStyle="bold"
                android:textColor="@color/venit_color"
                android:layout_marginBottom="@dimen/margin_medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="@dimen/margin_medium" />

            <!-- Cheltuieli -->
            <TextView
                android:id="@+id/textCheltuieli"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/total_cheltuieli"
                android:textSize="@dimen/text_header_size"
                android:textStyle="bold"
                android:textColor="@color/cheltuieli_color"
                android:layout_marginBottom="@dimen/margin_medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="@dimen/margin_medium" />

            <!-- Comisioane -->
            <TextView
                android:id="@+id/textComisioane"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/total_comisioane"
                android:textSize="@dimen/text_header_size"
                android:textStyle="bold"
                android:textColor="@color/cheltuieli_color"
                android:layout_marginBottom="@dimen/margin_medium" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginBottom="@dimen/margin_medium" />

            <!-- Sold -->
            <TextView
                android:id="@+id/textSold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/total_sold"
                android:textSize="@dimen/text_title_size"
                android:textStyle="bold"
                android:textColor="@color/sold_color"
                android:layout_marginBottom="@dimen/margin_medium" />
        </LinearLayout>

        <!-- Buton Înapoi -->
        <Button
            android:id="@+id/buttonInapoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inapoi_la_main"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/mybutton"
            android:layout_marginBottom="@dimen/margin_xlarge"
            android:layout_marginStart="@dimen/margin_standard"
            android:layout_marginEnd="@dimen/margin_standard"/>
    </LinearLayout>
</ScrollView>
